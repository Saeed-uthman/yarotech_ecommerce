{
  "name": "yarotech/api",
  "description": "YAROTECH ecommerce backend API (plain modern PHP + MySQL).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "dompdf/dompdf": "^3.1",
    "firebase/php-jwt": "^6.10",
    "phpmailer/phpmailer": "^6.9",
    "ramsey/uuid": "^4.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Helpers/functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
