APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yarotech_db
DB_USER=yarotech_user
DB_PASS=replace_with_strong_database_password
DB_CHARSET=utf8mb4

JWT_SECRET_OR_APP_KEY=replace_with_at_least_32_random_characters
JWT_TTL_MINUTES=720

PAYSTACK_PUBLIC_KEY=pk_live_replace_me
PAYSTACK_SECRET_KEY=sk_live_replace_me
PAYSTACK_WEBHOOK_SECRET=replace_with_paystack_webhook_secret

MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=support@example.com
MAIL_PASSWORD=replace_with_mail_password
MAIL_FROM_ADDRESS=support@example.com
MAIL_FROM_NAME=YAROTECH
MAIL_ENCRYPTION=ssl

POS_USE_MOCK=false
ADMIN_API_TOKEN=

ADMIN_EMAIL=support@example.com
ORDER_NOTIFICATION_EMAIL=support@example.com

VAT_ENABLED=true
VAT_RATE=0.075
DEFAULT_DELIVERY_FEE=25000
DEFAULT_ZONE_LABEL="Other Region"
DEFAULT_ETA="5-7 business days"
PICKUP_LABEL="Pickup at YAROTECH Lagos"
PICKUP_ETA="Ready in 24 hours"
