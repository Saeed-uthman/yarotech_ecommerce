APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/yarotech-api/public
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yarotech_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET_OR_APP_KEY=replace_with_at_least_32_random_characters
JWT_TTL_MINUTES=720

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=YAROTECH
MAIL_ENCRYPTION=tls

POS_API_BASE_URL=
POS_API_KEY=
POS_TIMEOUT=10
# When true (or when POS_API_BASE_URL/KEY are empty), PosService serves
# a deterministic mock catalogue so the storefront keeps working offline.
POS_USE_MOCK=true

# Static admin API token used by AdminMiddleware until JWT auth ships.
ADMIN_API_TOKEN=

ADMIN_EMAIL=support@yarotech.ng
ORDER_NOTIFICATION_EMAIL=support@yarotech.ng

# ---- Phase 4: Checkout / VAT / Delivery defaults ----
VAT_ENABLED=true
VAT_RATE=0.075
DEFAULT_DELIVERY_FEE=25000
DEFAULT_ZONE_LABEL="Other Region"
DEFAULT_ETA="5-7 business days"
PICKUP_LABEL="Pickup at YAROTECH Lagos"
PICKUP_ETA="Ready in 24 hours"


# ---- Phase 5: Payments / Paystack callbacks ----
# FRONTEND_URL above is used as the Paystack callback host. The full
# callback URL becomes "{FRONTEND_URL}/payment/processing?reference=...".
# Webhook URL to register in Paystack dashboard:
#   {APP_URL}/api/payments/webhook
